{
  "name": "cortex",
  "version": "0.1.0",
  "private": true,
  "description": "Cortex - a personal command centre: life, investments, news and an agent with memory.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "cli": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
