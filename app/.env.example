# Secrets live in the environment, never in config/cortex.json and never in git.
# Export these in your shell or service manager; Cortex does not read this file itself.

# Switches the agent on (chat and model-written briefs). Everything else works without it.
ANTHROPIC_API_KEY=

# Required if "host" is anything other than 127.0.0.1. At least 24 characters.
CORTEX_TOKEN=

# Only for Telegram delivery of briefs (with notify.telegramChatId in the config).
TELEGRAM_BOT_TOKEN=

# Optional overrides
# CORTEX_CONFIG=/path/to/cortex.json
# CORTEX_DATA=/path/to/data-directory
